# ── Required ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Set after running:  python index_rag.py --backend openai --pdf <pdf> ──
# Leave blank to use the local ChromaDB fallback instead
OPENAI_VECTOR_STORE_ID=

# ── Optional overrides ─────────────────────────────────────────────────────
GPT_MODEL=gpt-4o
DEFAULT_K_FRAMES=8

# ── Streamlit → FastAPI URL (change if deploying separately) ───────────────
API_URL=http://localhost:8000
